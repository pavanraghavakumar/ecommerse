# Copy this file to .env and fill in the values.
# The app reads these variables at runtime; none of them is committed.

# SQLite database file used by Prisma (relative to the prisma/ folder).
DATABASE_URL="file:./dev.db"

# Secret used to sign the session cookie. Use a long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# Payment provider (test mode) keys.
PAYMENT_PROVIDER_KEY="test_key"
PAYMENT_PROVIDER_SECRET="test_secret"

# The first Admin account, created after the migrations when both are set
# and no account exists yet.
FIRST_ADMIN_EMAIL="admin@shop.test"
FIRST_ADMIN_PASSWORD="Admin1234"
